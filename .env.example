# --- Obligatorias ---
# Supabase: usa la cadena del pooler (Settings → Database → Connection string). Local: docker compose up -d db
DATABASE_URL=postgres://airadar:airadar@localhost:54329/airadar
APP_TIMEZONE=Europe/Madrid
APP_URL=http://localhost:3000

# --- GitHub (muy recomendada: sin ella, 60 req/h y sin releases ni refresco de crecimiento) ---
# Token fine-grained de solo lectura de repos públicos.
GITHUB_TOKEN=

# --- Administración y publicación ---
ADMIN_PASSWORD=
SESSION_SECRET=          # >= 32 caracteres aleatorios
CRON_SECRET=             # >= 24 caracteres; para POST /api/cron
PRIVATE_DASHBOARD=false  # true: solo /tendencias y fichas publicadas son públicas
AUTO_PUBLISH=false
PUBLISH_MIN_SCORE=78
PUBLISH_MIN_CONFIDENCE=0.65
REVIEW_MIN_SCORE=70

# --- Almacenamiento de objetos (snapshots en bruto) ---
STORAGE_DRIVER=local     # local | s3 (MinIO) | none
LOCAL_STORAGE_DIR=.data/objects
S3_ENDPOINT=             # p. ej. https://minio.tudominio.com
S3_REGION=us-east-1
S3_BUCKET=ai-radar
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Límites de consumo GitHub por ejecución ---
GITHUB_MAX_SEARCH_REQUESTS=36
GITHUB_MAX_REFRESH_REPOS=400
GITHUB_MAX_AUDITS=80

# --- Fases siguientes (no usadas en la Fase 1) ---
GEMINI_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
DEMO_MODE=false

# Compilación estática (GitHub Pages)
STATIC_EXPORT=false
PAGES_BASE_PATH=/airadar
